VITE_RECAPTCHA_KEY = ""

# Base URL of the Go backend API, including the `/api/v1` prefix.
# Never hardcoded in source — the shared API layer reads it from here.
# Dev against docker-compose (the backend listens on :8080). If :8080 is
# shadowed on your machine (system proxy), point this at your mapped host/port.
VITE_API_URL = "http://localhost:8080/api/v1"
#
# The backend is also the source of the word lists (nothing ships in
# `public/static/languages` any more): the app reads `<base>/dictionaries` and
# fetches bodies from `<origin>/static/dictionaries/<dictHash>.json`, where
# `<origin>` is derived from this URL. A wrong value ⇒ no dictionaries ⇒ no text.

# Cloudflare Turnstile site key, guarding register / password-reset-request /
# verification-resend. Leave it EMPTY for local development: with no key the
# widget is never rendered, `turnstileToken` is never sent, and those forms
# behave exactly as they did before the captcha existed. That is the mirror of
# an empty `TYPEMORE_TURNSTILE_SECRET` on the backend, which is its dev default.
# Set both, or neither — a key here against a backend with no secret just makes
# users solve a challenge nobody checks.
VITE_TURNSTILE_SITE_KEY = ""
