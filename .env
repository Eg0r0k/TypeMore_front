VITE_PROTOCOL = "http"
VITE_HOST = "localhost"
# NOTE: VITE_DOMAIN/VITE_HOST/VITE_PROTOCOL are ALSO set as OS-level env vars on
# this machine (VITE_DOMAIN=...:3000) and shadow anything composed from them
# here, since dotenv never overrides an already-set process var. VITE_API_URL is
# therefore set as a literal (it is NOT in the OS env, so this value wins).
VITE_API_URL = "http://localhost:8090/api/v1"


